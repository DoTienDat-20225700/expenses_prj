# ========== Core Django ==========
# Sinh key ngẫu nhiên: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True cho development, False cho production
DEBUG=False

# Hosts được phép (ngoài localhost/127.0.0.1 đã mặc định)
# Ví dụ: myapp.onrender.com,example.com (Render tự inject RENDER_EXTERNAL_HOSTNAME)
ALLOWED_HOSTS=

# ========== Database ==========
# Ưu tiên DATABASE_URL (Render cung cấp tự động)
DATABASE_URL=

# Nếu không có DATABASE_URL, dùng các biến riêng lẻ
DATABASE_ENGINE=django.db.backends.mysql
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306

# ========== Gemini AI ==========
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=10000
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=60

# ========== Cloudinary (media storage) ==========
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========== Email ==========
# Để trống EMAIL_HOST để dùng console backend (in email ra terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=

# ========== Superuser (dùng cho build/CI) ==========
# Dùng bởi: manage.py createsuperuser --no-input
# hoặc: scripts/create_superuser.py
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
